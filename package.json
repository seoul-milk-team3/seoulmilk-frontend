{
  "name": "seoulmilk-front",
  "private": true,
  "scripts": {
    "lint": "pnpm --recursive eslint .",
    "lint:fix": "pnpm --recursive eslint . --fix",
    "tsconfig": "pnpm --filter @seoulmilk/tsconfig",
    "build:styles": "pnpm --filter @seoulmilk/styles build",
    "build:ui": "pnpm --filter @seoulmilk/ui build",
    "build:api": "pnpm --filter @seoulmilk/api build",
    "build:icon": "pnpm --filter @seoulmilk/icon build",
    "build:packages": "pnpm run build:styles && pnpm run build:ui && pnpm run build:icon",
    "build:main": "pnpm run build:packages && pnpm --filter main build",
    "build:agency": "pnpm run build:packages && pnpm --filter agency build",
    "svgr": "pnpm --filter @seoulmilk/icon generate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "root": true,
  "packageManager": "pnpm@9.1.3",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@tanstack/react-query": "^5.66.9",
    "@types/react-dropzone": "^5.1.0",
    "axios": "^1.8.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "pdfjs-dist": "^3.9.179",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.2.0",
    "tsup": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.4",
    "@eslint/js": "^9.19.0",
    "@storybook/addon-essentials": "^8.5.8",
    "@storybook/addon-interactions": "^8.5.8",
    "@storybook/addon-onboarding": "^8.5.8",
    "@storybook/addon-viewport": "^8.6.3",
    "@storybook/blocks": "^8.5.8",
    "@storybook/react": "^8.5.8",
    "@storybook/react-vite": "^8.5.8",
    "@storybook/test": "^8.5.8",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "concurrently": "^9.0.1",
    "eslint": "^9.19.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.5.2",
    "storybook": "^8.5.8",
    "storybook-addon-theme-provider": "^0.2.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.22.0"
  }
}
